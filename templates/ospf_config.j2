{% for intf in ospf_interfaces %}
interface {{ intf.name }}
 {% if intf.istagged | default(false) %}
 encapsulation dot1Q {{ intf.vlan_tag }}
 {% endif %}
 description {{ intf.description }}
 ip address {{ intf.ip_address }} {{ intf.subnet_mask }}
 no shutdown
{% endfor %}
router ospf {{ prod_ospf_process_id }}
router-id {{ router_id }}
{% for intf in ospf_interfaces %}
{% if intf.ospf_enabled %}
 network {{ intf.ip_address }} 0.0.0.255 area {{ intf.ospf_area }}
{% endif %}
{% endfor %}
{% for intf in ospf_interfaces %}
{% if intf.passive | default(false) %}
 passive-interface {{ intf.name }}
{% endif %}
{% endfor %}
!
end