# NetBox stack environment.
# chmod 600 this file and keep it out of git.

# --- Database ---
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=CHANGEME_db
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=CHANGEME_db

# --- Redis: task queue ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME_redis
REDIS_DATABASE=0
REDIS_SSL=false

# --- Redis: cache ---
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=CHANGEME_rediscache
REDIS_CACHE_DATABASE=1
REDIS_CACHE_SSL=false

# --- NetBox ---
# 50+ random characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGEME_generate_a_long_random_string_at_least_fifty_chars

ALLOWED_HOSTS=*
SKIP_SUPERUSER=true
TIME_ZONE=America/Denver

# Set once you have a hostname or are behind a proxy
# CSRF_TRUSTED_ORIGINS=http://192.168.50.23:8080

# --- Optional ---
LOGLEVEL=INFO
MEDIA_ROOT=/opt/netbox/netbox/media
METRICS_ENABLED=false
